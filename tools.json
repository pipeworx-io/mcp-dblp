      "properties": {
        "query": {
          "type": "string",
          "description": "Author name (full or partial)"
        },
        "hits": {
          "type": "number",
          "description": "1-1000 (default 30)"
        },
        "first": {
          "type": "number",
          "description": "0-based offset"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  {
